
int led1 = 8;
int led2 = 9;

unsigned long previous1 = 0;
unsigned long previous2 = 0;

int state1 = LOW;
int state2 = LOW;

void setup() {
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
}

void loop() {
  unsigned long currentTime = millis();

  if (currentTime - previous1 >= 500) {
    previous1 = currentTime;
    state1 = !state1;
    digitalWrite(led1, state1);
  }

  if (currentTime - previous2 >= 1000) {
    previous2 = currentTime;
    state2 = !state2;
    digitalWrite(led2, state2);
  }
}
